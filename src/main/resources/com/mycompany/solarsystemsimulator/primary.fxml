<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="900.0" spacing="20.0" style="-fx-background-color: #101010;" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.solarsystemsimulator.PrimaryController">
   <children>
      <Label style="-fx-text-fill: white; -fx-font-size: 28px;" text="Solar System Simulator" />
      <Button fx:id="newSimulationButton" onAction="#switchToSecondary" prefWidth="200.0" style="-fx-font-size: 16px; -fx-background-color: #dce7f5;" text="New Simulation" />
      <Button fx:id="loadSimulationButton" onAction="#loadSimulationButtonPressed" prefWidth="200.0" style="-fx-font-size: 16px; -fx-background-color: #dce7f5;" text="Load Simulation" />
      <Button fx:id="creditsButton" onAction="#creditsButtonPressed" prefWidth="200.0" style="-fx-font-size: 16px; -fx-background-color: #dce7f5;" text="Credits" />
      <Button fx:id="quitButton" onAction="#quitButtonPressed" prefWidth="200.0" style="-fx-font-size: 16px; -fx-background-color: #dce7f5;" text="Quit" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
