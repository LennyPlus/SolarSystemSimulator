<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="setupBox" alignment="CENTER" prefHeight="430.0" prefWidth="500.0" spacing="12.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.solarsystemsimulator.SetupController">
   <children>
      <Label text="Simulation Setup" />
      <TextField fx:id="timestepField" promptText="Timestep (days)" />
      <TextField fx:id="lengthField" promptText="Simulation length (days)" />
      <Button mnemonicParsing="false" onAction="#startSimulation" text="Start Simulation" />
      <Button mnemonicParsing="false" onAction="#backToMenu" text="Back to Main Menu" />
   </children>
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
</VBox>
