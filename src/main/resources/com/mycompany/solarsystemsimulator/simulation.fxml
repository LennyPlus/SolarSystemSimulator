<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<Pane fx:id="simulationPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.solarsystemsimulator.SimulationController">
   <children>
      <BorderPane prefHeight="200.0" prefWidth="200.0">
         <top>
            <MenuBar style="-fx-background-color: LIGHTGREY;" BorderPane.alignment="CENTER">
              <menus>
                <Menu text="_File">
                  <items>
                    <MenuItem onAction="#onMenuItemExitToMainMenu" text="_Exit to main menu" />
                        <MenuItem mnemonicParsing="false" onAction="#onMenuItemExit" text="Exit" />
                  </items>
                </Menu>
                <Menu text="_Edit">
                  <items>
                    <MenuItem onAction="#onMenuItemPauseSimulation" text="_Pause Simulation" />
                        <MenuItem onAction="#onMenuItemPauseSimulation" text="_Save Simulation" />
                        <MenuItem onAction="#onMenuItemLoadSimulation" text="_Load Simulation" />
                  </items>
                </Menu>
                <Menu text="_Help">
                  <items>
                    <MenuItem mnemonicParsing="false" text="About" />
                  </items>
                </Menu>
              </menus>
            </MenuBar>
         </top>
         <center>
            <Canvas fx:id="simulationCanvas" height="600.0" width="900.0" BorderPane.alignment="CENTER" />
         </center>
      </BorderPane>
      <VBox layoutX="14.0" layoutY="50.0" prefWidth="260.0" spacing="6.0" style="-fx-background-color: -fx-background; -fx-background-radius: 6; -fx-padding: 10;">
         <Label fx:id="simulationTimeLabel" text="Day: 0" />
         <Label text="Planet facts" />
         <ChoiceBox fx:id="planetSelector" accessibleText="Select a planet" />
         <Label fx:id="planetFacts" wrapText="true" />
      </VBox>
   </children>
</Pane>
